# Stage 1: HTTP-only, used to bootstrap the Let's Encrypt certificate.
# Copy to clinicnet.conf FIRST, before running certbot for the first time —
# see docs/DEPLOY.md. Once a real certificate exists, switch to
# clinicnet-ssl.conf.template instead.
server {
    listen 80;
    server_name clinicnet.stom.asia;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /static/ {
        alias /app/staticfiles/;
    }

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
