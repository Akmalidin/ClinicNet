[Unit]
Description=ClinicNet (Django/gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/clinicnet
EnvironmentFile=/var/www/clinicnet/.env
ExecStart=/var/www/clinicnet/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8041 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
