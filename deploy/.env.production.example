# Скопировать в .env в корне репозитория на сервере и заполнить.
# ЭТО НЕ КОММИТИТЬ В GIT (уже в .gitignore как .env).

DEBUG=False
SECRET_KEY=<см. значение, сгенерированное в докладе — вставить сюда>
ALLOWED_HOSTS=clinicnet.stom.asia

DB_NAME=clinicnet
DB_USER=clinicnet
DB_PASSWORD=<см. значение, сгенерированное в докладе — вставить сюда>
