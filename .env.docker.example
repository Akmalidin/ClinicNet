# Шаблон для .env НА СЕРВЕРЕ (docker-compose.yml, сервис `web`, и
# переменные POSTGRES_* сервиса `db` — см. docker-compose.yml).
# Скопировать в .env в корне репозитория на сервере, заполнить реальными
# значениями, chmod 600. НЕ коммитить (.gitignore уже исключает .env).
#
# Отличия от .env.example (локальная разработка):
#  - DEBUG=False (в проде всегда)
#  - DB_HOST=db — имя сервиса Postgres в docker-сети, не 127.0.0.1
#  - ALLOWED_HOSTS — реальный домен, не localhost
DEBUG=False
SECRET_KEY=сгенерировать-длинный-случайный-секрет
ALLOWED_HOSTS=clinicnet.stom.asia

DB_NAME=clinicnet
DB_USER=clinicnet
DB_PASSWORD=сгенерировать-длинный-случайный-пароль
DB_HOST=db
DB_PORT=5432
